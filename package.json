{
  "name": "editor-texto-inteligente",
  "productName": "Editor Inteligente IA",
  "version": "0.9.0",
  "description": "Editor de documentos profesional con maquetación avanzada y asistencia contextual de Gemini",
  "author": "Editor Inteligente IA",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:dev": "concurrently -k \"npm:dev\" \"npm:desktop:launch\"",
    "desktop:launch": "wait-on http://127.0.0.1:3000 && electron . --dev",
    "desktop:package": "npm run build && electron-forge package",
    "desktop:make": "npm run build && electron-forge make",
    "desktop:portable": "npm run build && electron-builder --win portable --x64",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@google/genai": "^2.13.0",
    "better-sqlite3": "^13.0.1",
    "citeproc": "^2.4.63",
    "electron-squirrel-startup": "^1.0.1",
    "fast-xml-parser": "^5.10.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "mammoth": "^1.9.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
