    "pdfjs-dist": "^4.10.38",
    "pdfmake": "^0.3.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0",
